# Server Configuration
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/freelancecomm_booking
REDIS_URL=redis://localhost:6379

# Google API Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_CALENDAR_ID=primary
GOOGLE_MEET_DEFAULT_DURATION=30 # minutes

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Chatbot Configuration
CHATBOT_WEBHOOK_SECRET=your_chatbot_webhook_secret
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
DIALOGFLOW_PROJECT_ID=your_dialogflow_project_id
DIALOGFLOW_PRIVATE_KEY=your_dialogflow_private_key
DIALOGFLOW_CLIENT_EMAIL=your_dialogflow_client_email

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
EMAIL_FROM=noreply@freelancecomm.in

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Timezone
DEFAULT_TIMEZONE=Asia/Kolkata